# Variables del backend en el servidor. Se sube UNA vez (deploy.sh no lo pisa).
SYMFONY_ENV=prod

# Generar uno nuevo, distinto al de desarrollo:
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
JWT_SECRET=CAMBIAR

JWT_TTL=28800

# Frontend y API están en el mismo dominio: CORS no se usa, pero la variable tiene que existir
CORS_ALLOW_ORIGIN=^https://CAMBIAR-DOMINIO$

# Zona horaria de las fechas (por defecto America/Argentina/Buenos_Aires)
APP_TIMEZONE=America/Argentina/Buenos_Aires

# Quién puede anular ventas, compras, canjes y pases: todos | admin | propias_hoy
ANULACION_PERMITIDA=todos
