# Copiar este archivo como .env y completar los valores reales.
# NUNCA subir el archivo .env al repositorio.

# dev para trabajar en local (habilita server:run); prod en el servidor publicado
SYMFONY_ENV=dev

# mysql://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE
# Con XAMPP en local suele ser root sin contraseña. En producción usar un
# usuario propio con permisos mínimos (ver README).
DATABASE_URL=mysql://root:@127.0.0.1:3306/emmaaccesorios?serverVersion=mariadb-10.4.32&charset=utf8mb4

# Secreto para firmar los tokens JWT (mínimo 32 caracteres aleatorios).
# Generar uno con:  php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO_DE_64_CARACTERES

# Duración del token en segundos (8 horas)
JWT_TTL=28800

# Orígenes permitidos para CORS (expresión regular)
CORS_ALLOW_ORIGIN=^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$

# Zona horaria de las fechas (por defecto America/Argentina/Buenos_Aires)
APP_TIMEZONE=America/Argentina/Buenos_Aires

# Quién puede anular ventas, compras, canjes y pases: todos | admin | propias_hoy
ANULACION_PERMITIDA=todos
