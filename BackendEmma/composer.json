{
    "name": "emma/backend",
    "description": "API REST de Emma Accesorios (Symfony 3.4 LTS)",
    "type": "project",
    "license": "proprietary",
    "autoload": {
        "psr-4": {
            "AppBundle\\": "src/AppBundle"
        },
        "classmap": [
            "app/AppKernel.php"
        ]
    },
    "require": {
        "php": ">=7.1.3",
        "ext-json": "*",
        "ext-pdo_mysql": "*",
        "doctrine/dbal": "^2.13",
        "doctrine/doctrine-bundle": "^1.12",
        "firebase/php-jwt": "^6.0",
        "symfony/dotenv": "3.4.*",
        "symfony/monolog-bundle": "^3.5",
        "symfony/symfony": "3.4.*",
        "doctrine/orm": "^2.7",
        "doctrine/annotations": "^1.13"
    },
    "config": {
        "sort-packages": true,
        "platform-check": false,
        "platform": {
            "php": "7.4.33"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@php bin/console cache:clear --no-warmup"
        ]
    }
}